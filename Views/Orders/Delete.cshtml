@model OrderManagementApp.Models.Entities.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container mt-4">
    <h1 class="mb-4">Delete Order</h1>

    <div class="alert alert-danger" role="alert">
        <strong>Warning:</strong> Are you sure you want to delete this order? This action cannot be undone.
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Order Details</h5>
            <table class="table">
                <tr>
                    <th width="30%">Order Number:</th>
                    <td><strong>@Model.OrderNumber</strong></td>
                </tr>
                <tr>
                    <th>Customer Name:</th>
                    <td>@Model.CustomerName</td>
                </tr>
                <tr>
                    <th>Customer Email:</th>
                    <td>@Model.CustomerEmail</td>
                </tr>
                <tr>
                    <th>Product:</th>
                    <td>@Model.Product?.ProductName</td>
                </tr>
                <tr>
                    <th>Quantity:</th>
                    <td>@Model.Quantity</td>
                </tr>
                <tr>
                    <th>Order Date:</th>
                    <td>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
                <tr>
                    <th>Status:</th>
                    <td>
                        @if (Model.Status == "Delivered")
                        {
                            <span class="badge bg-success">Delivered</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">Pending</span>
                        }
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="OrderId" />
        <div class="d-grid gap-2 d-md-flex justify-content-md-start">
            <button type="submit" class="btn btn-danger">Delete Order</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@model OrderManagementApp.Models.Entities.Order

@{
    ViewData["Title"] = "Create Order";
    var products = ViewData["Products"] as List<OrderManagementApp.Models.Entities.Product> ?? new();
}

<div class="container mt-4">
    <h1 class="mb-4">Create New Order</h1>

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="OrderNumber" class="form-label">Order Number *</label>
                    <input asp-for="OrderNumber" class="form-control" placeholder="ORD-YYYYMMDD-XXXX (e.g., ORD-20260117-0001)">
                    <small class="text-muted d-block mt-1">Format: ORD-YYYYMMDD-XXXX</small>
                    <span asp-validation-for="OrderNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label">Customer Name *</label>
                    <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name (2-100 characters)">
                    <span asp-validation-for="CustomerName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CustomerEmail" class="form-label">Customer Email *</label>
                    <input asp-for="CustomerEmail" type="email" class="form-control" placeholder="example@email.com">
                    <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ProductId" class="form-label">Product *</label>
                    <select asp-for="ProductId" class="form-select">
                        <option value="">-- Select a Product --</option>
                        @foreach (var product in products)
                        {
                            <option value="@product.ProductId">@product.ProductName (Stock: @product.StockQuantity)</option>
                        }
                    </select>
                    <span asp-validation-for="ProductId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Quantity" class="form-label">Quantity *</label>
                    <input asp-for="Quantity" type="number" class="form-control" placeholder="Enter quantity" min="1">
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="OrderDate" class="form-label">Order Date *</label>
                    <input asp-for="OrderDate" type="datetime-local" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DeliveryDate" class="form-label">Delivery Date (Optional)</label>
                    <input asp-for="DeliveryDate" type="datetime-local" class="form-control">
                    <small class="text-muted d-block mt-1">Must be greater than or equal to Order Date</small>
                    <span asp-validation-for="DeliveryDate" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                    <button type="submit" class="btn btn-success">Create Order</button>
                    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
